# Application
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/alsm
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Bank account encoded into the EMVCo/VietQR payload
CASSO_BANK_BIN=970436
CASSO_BANK_ACCOUNT_NUMBER=your-bank-account-number
CASSO_BANK_ACCOUNT_NAME=YOUR ACCOUNT NAME

# Casso transaction polling and webhook verification
CASSO_API_KEY=your-casso-api-key
CASSO_WEBHOOK_SECRET=your-casso-secure-token
